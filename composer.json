{
	"name": "dananghel89/easypack-appstarter",
	"description": "EasyPack App",
	"type": "project",
	"license": "MIT",
	"repositories": {
		"dananghel89/easypack-framework": {
			"type": "vcs",
			"url": "https://github.com/dananghel89/easypack-framework"
		}
	},
	"require": {
		"php": ">=7.0",
		"dananghel89/easypack-framework": "^1.0"
	},
	"require-dev": {
		"pestphp/pest": "^5.3",
		"laravel/pint": "^1.32"
	},
	"autoload": {
		"psr-4": {
			"App\\": "app/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "@php -d xdebug.mode=off vendor/bin/pest",
		"lint": "pint",
		"test:lint": "pint --test"
	},
	"config": {
		"allow-plugins": {
			"pestphp/pest-plugin": true
		}
	}
}
