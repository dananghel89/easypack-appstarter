{
	"name": "dananghel89/easypack-appstarter",
	"description": "EasyPack App",
	"type": "project",
	"repositories": {
		"dananghel89/easypack-framework": {
			"type": "path",
			"url": "../easypack-framework",
			"options": {
				"symlink": true
			}
		}
	},
	"require": {
		"php": ">=7.0",
		"dananghel89/easypack-framework": "dev-master"
	},
	"autoload": {
		"psr-4": {
			"App\\": "app/"
		}
	}
}
