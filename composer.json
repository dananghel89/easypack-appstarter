{
	"name": "dananghel89/easypack-appstarter",
	"description": "EasyPack App",
	"type": "project",
	"repositories": {
		"dananghel89/easypack-framework": {
			"type": "path",
			"url": "../easypack-framework",
			"options": {
				"symlink": true
			}
		}
	},
	"require": {
		"php": ">=7.0",
		"dananghel89/easypack-framework": "dev-master"
	},
	"require-dev": {
		"pestphp/pest": "^5.3",
		"laravel/pint": "^1.32"
	},
	"autoload": {
		"psr-4": {
			"App\\": "app/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "pest",
		"lint": "pint",
		"test:lint": "pint --test"
	},
	"config": {
		"allow-plugins": {
			"pestphp/pest-plugin": true
		}
	}
}
